* text=auto
*.ps1 text eol=crlf
*.sh text eol=lf
.githooks/* text eol=lf
*.png binary
*.webp binary
*.woff2 binary
*.wav binary
*.bin binary

# Vendored sources keep their bytes exactly (the tree hash in third_party/README.md must match on every checkout).
third_party/** -text

# Tauri regenerates these on every build with LF; keep them LF in the index and in the working tree so
# git status stays clean on Windows (core.autocrlf).
src-tauri/permissions/autogenerated/*.toml text eol=lf
